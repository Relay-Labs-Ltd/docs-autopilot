#!/usr/bin/env node
/**
 * public-release-notes.mjs — the ONE customer-facing release-note format.
 *
 * release-please writes an engineering changelog (one bullet per commit, SHA
 * stamped, scope-prefixed). This turns that body into the note customers see:
 *
 *   # {{APP_NAME}} v1.4.0
 *   This release brings improvements to {{APP_NAME}}. …
 *   ## What’s new / ## Improvements / ## Fixes / ## Breaking changes
 *   - One line per change, no SHAs, no PR numbers, no internal scopes,
 *     duplicates collapsed.
 *   ## Notes
 *
 * changelog-on-release.yml runs it before ingesting a release, when this file
 * exists. Idempotent: a body already in this format is returned unchanged, and
 * so is anything that is NOT release-please output (a note a person wrote or
 * edited), so a re-run never overwrites hand-written text.
 *
 *   node scripts/release-notes/public-release-notes.mjs <version> \
 *     < release-body.md > public-note.md
 *
 * No dependencies. Zero exit on success; the workflow treats a non-zero exit as
 * fatal and ingests nothing, so re-running the workflow with the tag recovers.
 */
import { pathToFileURL } from "node:url";

const APP = process.env.APP_NAME || "{{APP_NAME}}";

/** Public heading for each release-please section, in display order. Matches
 *  the sections in release-please-config.json AND release-please's defaults,
 *  so a backfill of an old tag works too. */
const SECTIONS = [
  { match: (h) => /breaking/i.test(h), heading: "Breaking changes" },
  { match: (h) => /^(new|features?)$/i.test(h), heading: "What’s new" },
  { match: (h) => /^(improved|performance improvements?|code refactoring)$/i.test(h), heading: "Improvements" },
  { match: (h) => /^(fixed|bug fixes)$/i.test(h), heading: "Fixes" },
  { match: (h) => /^(reverted|reverts)$/i.test(h), heading: "Reverted" },
];

/** Commit scopes no customer can act on. Conservative on purpose: a bullet you
 *  delete in the editor is cheaper than a feature the filter swallowed. */
const INTERNAL_SCOPES = /^(ci|build|deps|dev-deps|chore|test|tests|docs|lint|release|internal|tooling)$/i;

const escapeRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

export function isPublicReleaseNote(body) {
  return new RegExp(`^# ${escapeRe(APP)} v\\d`).test(String(body ?? "").trim());
}

/** release-please's own body: a version heading, then nothing but headings and
 *  bullets. Prose, a migration paragraph, a code block — anything a person
 *  wrote — fails this and is passed through untouched. */
export function isReleasePleaseBody(body) {
  const lines = String(body ?? "")
    .split(/\r?\n/)
    .map((l) => l.trim())
    .filter(Boolean);
  if (lines.length === 0) return false;
  if (!/^#{1,3}\s*\[?v?\d+\.\d+\.\d+/.test(lines[0])) return false;
  return lines.slice(1).every((l) => /^#{2,4}\s/.test(l) || /^[-*]\s/.test(l));
}

function parse(body) {
  const sections = [];
  let current = null;
  for (const raw of String(body).split(/\r?\n/)) {
    const line = raw.trim();
    const h = /^#{2,4}\s+(.+?)\s*$/.exec(line);
    if (h) {
      // "## [1.2.0](url) (2026-10-20)" is the version heading, not a section.
      if (/^\[?v?\d+\.\d+\.\d+/.test(h[1])) continue;
      current = { heading: h[1].replace(/^[^\w]+/, "").trim(), items: [] };
      sections.push(current);
      continue;
    }
    const b = /^[-*]\s+(.+)$/.exec(line);
    if (b && current) {
      let text = b[1];
      let scope = null;
      const s = /^\*\*([^*]+?):\*\*\s*(.+)$/.exec(text);
      if (s) {
        scope = s[1].trim();
        text = s[2];
      }
      text = text
        .replace(/\s*\(\[[0-9a-f]{6,40}\]\([^)]*\)\)/gi, "") // ([abc1234](commit-url))
        .replace(/\s*\(\[#\d+\]\([^)]*\)\)/g, "") // ([#123](issue-url))
        .replace(/\s*\(#\d+\)/g, "") // (#123)
        .replace(/\s*,\s*closes\s+#\d+.*$/i, "")
        .trim();
      if (text) current.items.push({ scope, subject: text });
    }
  }
  return sections;
}

function dedupe(items) {
  const seen = new Set();
  const out = [];
  for (const item of items) {
    const key = item.subject.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
    if (seen.has(key)) continue;
    seen.add(key);
    out.push(item);
  }
  return out;
}

export function renderPublicReleaseNotes(version, body) {
  const v = String(version).replace(/^v/, "");
  if (isPublicReleaseNote(body)) return String(body).trim() + "\n";
  if (!isReleasePleaseBody(body)) return String(body ?? "");

  const sections = parse(body);
  const blocks = [];
  for (const { match, heading } of SECTIONS) {
    const items = dedupe(
      sections
        .filter((s) => match(s.heading))
        .flatMap((s) => s.items)
        .filter((i) => !(i.scope && INTERNAL_SCOPES.test(i.scope))),
    );
    if (items.length === 0) continue;
    const lines = items.map(({ subject }) => `- ${subject.charAt(0).toUpperCase()}${subject.slice(1)}`);
    blocks.push(`## ${heading}`, "", ...lines, "");
  }

  const intro = blocks.length
    ? `This release brings improvements to ${APP}. The changes that matter to your team are listed below.`
    : `This release contains maintenance and reliability work only. There are no changes to how you use ${APP}.`;

  return [
    `# ${APP} v${v}`,
    "",
    intro,
    "",
    ...blocks,
    "## Notes",
    "",
    "Questions about this release? Contact support and we will help.",
    "",
  ].join("\n");
}

// CLI: node public-release-notes.mjs <version> < body.md
if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  const version = process.argv[2];
  if (!version) {
    console.error("usage: public-release-notes.mjs <version> < release-body.md");
    process.exit(2);
  }
  let input = "";
  for await (const chunk of process.stdin) input += chunk;
  process.stdout.write(renderPublicReleaseNotes(version, input));
}
