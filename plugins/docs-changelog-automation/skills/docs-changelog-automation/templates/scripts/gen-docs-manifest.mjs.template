#!/usr/bin/env node
/**
 * gen-docs-manifest.mjs — build-time inventory behind a Dev Docs viewer.
 *
 * Enumerates the canonical developer docs (root markdown + docs/**) and, when a
 * git checkout is available at build time, stamps each with its last-commit
 * provenance (date · short hash · subject). Written to
 * src/generated/dev-docs-manifest.json (adjust OUT for non-Next apps).
 *
 * MUST NEVER FAIL THE BUILD: every step is wrapped; on any error we still write
 * a best-effort (possibly empty) manifest and exit 0.
 *
 * The manifest is TRACKED in git. Production Docker builds often run without
 * .git and without a git binary, so when git is unavailable we KEEP the
 * committed manifest — its stamped provenance beats nulls. CI and local builds,
 * which have git, refresh it.
 */
import { execSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";

const ROOT = process.cwd();
const OUT_DIR = path.join(ROOT, "src", "generated");
const OUT = path.join(OUT_DIR, "dev-docs-manifest.json");

// Root-level docs that form the "Core" group, in display order. Adapt to the repo.
const ROOT_DOCS = ["README.md", "AGENTS.md", "CHANGELOG.md"];

function walkDocs(dir, acc) {
  let entries = [];
  try {
    entries = fs.readdirSync(dir, { withFileTypes: true });
  } catch {
    return acc;
  }
  for (const e of entries) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) walkDocs(p, acc);
    else if (e.name.endsWith(".md") && !e.name.endsWith(".prompt.md")) acc.push(path.relative(ROOT, p));
  }
  return acc;
}

let gitAvailable = false;
try {
  execSync("git rev-parse --is-inside-work-tree", { cwd: ROOT, stdio: "ignore" });
  gitAvailable = true;
} catch {
  gitAvailable = false;
}

if (!gitAvailable) {
  try {
    const existing = JSON.parse(fs.readFileSync(OUT, "utf8"));
    if (Array.isArray(existing?.docs) && existing.docs.length > 0) {
      console.log(`dev-docs manifest: git unavailable — keeping committed manifest (${existing.docs.length} docs).`);
      process.exit(0);
    }
  } catch {
    /* no usable committed manifest — generate without provenance */
  }
}

function gitInfo(rel) {
  if (!gitAvailable) return null;
  try {
    const out = execSync(`git log -1 --format=%cI%x09%h%x09%s -- "${rel}"`, {
      cwd: ROOT,
      stdio: ["ignore", "pipe", "ignore"],
    })
      .toString()
      .trim();
    if (!out) return null;
    const [updatedAt, commit, subject] = out.split("\t");
    return { updatedAt, commit, subject };
  } catch {
    return null;
  }
}

function firstTitleAndSummary(rel) {
  try {
    const text = fs.readFileSync(path.join(ROOT, rel), "utf8");
    const lines = text.split(/\r?\n/);
    let title = null;
    let summary = null;
    for (const line of lines) {
      const t = line.trim();
      if (!t) continue;
      if (!title && /^#\s+/.test(t)) {
        title = t.replace(/^#\s+/, "").trim();
        continue;
      }
      if (title && !/^#{1,6}\s/.test(t) && !/^[-*>|`\[]/.test(t)) {
        summary = t.replace(/\[([^\]]*)\]\([^)]*\)/g, "$1").slice(0, 200);
        break;
      }
    }
    return { title: title || path.basename(rel, ".md"), summary };
  } catch {
    return { title: path.basename(rel, ".md"), summary: null };
  }
}

const slugFor = (rel) => rel.replace(/\.md$/i, "").split(path.sep).join("__");
const groupFor = (rel) => {
  if (!rel.includes("/")) return "core";
  const parts = rel.split("/");
  return parts.length > 2 ? `${parts[0]}/${parts[1]}` : parts[0];
};

try {
  const rels = [
    ...ROOT_DOCS.filter((f) => fs.existsSync(path.join(ROOT, f))),
    ...walkDocs(path.join(ROOT, "docs"), []).sort(),
  ];
  const docs = rels.map((rel) => {
    const { title, summary } = firstTitleAndSummary(rel);
    const git = gitInfo(rel);
    return {
      slug: slugFor(rel),
      relPath: rel,
      title,
      summary,
      group: groupFor(rel),
      updatedAt: git?.updatedAt ?? null,
      commit: git?.commit ?? null,
      subject: git?.subject ?? null,
    };
  });
  fs.mkdirSync(OUT_DIR, { recursive: true });
  fs.writeFileSync(OUT, JSON.stringify({ generatedAt: new Date().toISOString(), gitAvailable, docs }, null, 2));
  console.log(`dev-docs manifest: ${docs.length} docs (git ${gitAvailable ? "available" : "unavailable"}) → ${path.relative(ROOT, OUT)}`);
} catch (err) {
  try {
    fs.mkdirSync(OUT_DIR, { recursive: true });
    fs.writeFileSync(OUT, JSON.stringify({ generatedAt: new Date().toISOString(), gitAvailable: false, docs: [] }, null, 2));
  } catch {
    /* last resort: nothing to write */
  }
  console.warn("dev-docs manifest: generation failed (non-fatal):", err?.message ?? err);
}
process.exit(0);
